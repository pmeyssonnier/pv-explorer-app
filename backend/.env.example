# ═══════════════════════════════════════════════════════════════
# EXEMPLE de configuration — copie ce fichier en .env et remplis
#   cp .env.example .env
# Le vrai .env n'est JAMAIS committé (voir .gitignore)
# ═══════════════════════════════════════════════════════════════

# ── SECRETS (obligatoires) ─────────────────────────────────────
# Clé API Anthropic — https://console.anthropic.com  (réponses Claude, /ask)
ANTHROPIC_API_KEY=sk-ant-remplace-moi

# Clé API Pinecone — https://app.pinecone.io  (recherche vectorielle + indexation)
PINECONE_API_KEY=pcsk_remplace-moi

# ── RÉGLAGES (non secrets) ─────────────────────────────────────
# Chemin du fichier JSON des PV (lu par /stats et /elu). Laisse le défaut.
PV_JSON_PATH=pv_conseil_schaerbeek.json

# Origines CORS autorisées = URL(s) EXACTE(S) du frontend, séparées par des
# virgules SANS espace. En dev, laisse vide → localhost autorisé par défaut.
# En prod, mets l'URL Vercel :
ALLOWED_ORIGINS=https://pv-explorer.vercel.app

# Seuil de pertinence (optionnel). 0.0 = désactivé (aucun filtrage).
# À calibrer avec backend/eval_rag.py ; laisser 0.0 si tu ne sais pas.
# SCORE_MIN=0.0

# ═══════════════════════════════════════════════════════════════
# À NE PAS OUBLIER (hors .env) :
#  • Index Pinecone nommé "pv-explorer", namespace "pv", embeddings intégrés
#    "multilingual-e5-large" — créé et peuplé par `python index_pv.py`.
#    (Le nom d'index est une constante : backend/config.py → INDEX_NAME.)
#  • Frontend : `API_PROD` en haut de frontend/app.js doit pointer vers
#    l'URL de TON backend (ce n'est PAS une variable d'env, c'est dans le code).
# ═══════════════════════════════════════════════════════════════
