# ═══════════════════════════════════════════════════════════════
# EXEMPLE de configuration — copie ce fichier en .env et remplis
#   cp .env.example .env
# Le vrai .env n'est JAMAIS committé (voir .gitignore)
# ═══════════════════════════════════════════════════════════════

# Clé API Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-remplace-moi

# Clé API Pinecone — https://app.pinecone.io
PINECONE_API_KEY=pcsk_remplace-moi

# Chemin du fichier JSON des PV (pour l'endpoint /stats)
PV_JSON_PATH=pv_conseil_schaerbeek.json

# Origines CORS autorisées (URL exacte du frontend, séparées par virgules).
# En dev, laisse vide → localhost autorisé par défaut.
# En prod, mets l'URL Vercel : https://pv-explorer.vercel.app
ALLOWED_ORIGINS=https://pv-explorer.vercel.app
